# Public metadata and host file paths only. Do not put passwords, tokens or keys here.
LIAR_PUBLIC_ORIGIN=https://your-confirmed-domain.example
LIAR_SECRETS_DIR=/absolute/restricted/liar-secrets
# Override with reviewed immutable release references when deploying.
LIAR_SERVER_IMAGE=liar-server:local
LIAR_WEB_IMAGE=liar-web:local
LIAR_POSTGRES_IMAGE=postgres:18-alpine
LIAR_TUNNEL_IMAGE=cloudflare/cloudflared:latest
# Requires actual CMP/site approval and the operator CSP checks in #147.
VITE_CMP_PROVIDER=
VITE_ADSENSE_CLIENT_ID=
# Optional backup overlay only. Use a separately mounted medium, UID 10001 writable.
LIAR_BACKUP_DIR=/absolute/separate-medium/liar-backups
LIAR_BACKUP_IMAGE=liar-backup:local

# Independent encrypted rights checkpoint; separate protected medium.
LIAR_LEDGER_DIR=/absolute/separate-medium/liar-rights
LIAR_LEDGER_IMAGE=liar-ledger:local
# Only controlled recovery: original source's private Docker db network.
# LIAR_RECOVERY_SOURCE_NETWORK=original-project_db
