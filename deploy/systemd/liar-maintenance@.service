[Unit]
Description=Liar Sweeper isolated %i maintenance
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=liar
Group=docker
WorkingDirectory=/opt/liar/current
UMask=0077
ExecStart=/usr/bin/python3 deploy/maintenance.py %i --env-file /etc/liar/runtime.env --state-dir /var/lib/liar-maintenance
TimeoutStartSec=1950
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/liar-maintenance
