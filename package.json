{
  "name": "liar-sweeper",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "pnpm --filter @liar/web dev",
    "build": "pnpm tokens:check && pnpm wasm:build && pnpm --filter @liar/web build",
    "lint": "oxlint apps packages scripts tests --deny-warnings",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.tools.json",
    "test": "pnpm --filter @liar/web test",
    "test:e2e": "playwright test",
    "docs:check": "python scripts/validate_docs.py && node scripts/check_mermaid.mjs .",
    "types:generate": "cargo run --locked -p liar-protocol --bin export-types",
    "types:check": "cargo run --locked -p liar-protocol --bin export-types -- --check",
    "wasm:build": "node scripts/build-wasm.mjs --check",
    "wasm:generate": "node scripts/build-wasm.mjs",
    "fixtures:generate": "cargo run --locked --release -p liar-wasm --bin native-fixture",
    "fixtures:check": "cargo run --locked --release -p liar-wasm --bin native-fixture -- --check",
    "tokens:generate": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check",
    "format:check": "prettier --check apps/web/src apps/web/test apps/web/vitest.config.ts apps/web/tsconfig.json tests/e2e/shell.spec.ts tests/e2e/bootstrap.spec.ts tests/e2e/board.spec.ts packages/design-tokens/tokens.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "jsdom": "^30.1.2",
    "mermaid": "^12.1.0",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.9.1"
}
